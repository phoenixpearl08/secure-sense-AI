# SECURE SENSE — Intelligent Security & Document Intelligence
# Environment Configuration Template
# NEVER COMMIT REAL SECRETS, CREDENTIALS, OR ENCRYPTION KEYS TO GIT

# Application URLs
APP_URL=http://localhost:3000
API_URL=http://localhost:3000/api
NODE_ENV=production

# Database (PostgreSQL + Prisma)
# When omitted, SECURE SENSE operates on the zero-config self-healing JSON store
# Format: postgresql://<user>:<password>@<host>:<port>/<database>?schema=public
# DATABASE_URL=postgresql://user:password@localhost:5432/securesense?schema=public

# Encryption Master Secret (Base derivation key for AES-256-GCM authenticated vault encryption)
# Must be at least 32 characters in production. Generate with: openssl rand -hex 32
VAULT_MASTER_KEY=your_secure_32_byte_master_encryption_key_here

# Session Secret (Used for signing authenticated JWT session cookies)
# Must be at least 32 characters in production. Generate with: openssl rand -hex 32
SESSION_SECRET=your_secure_32_byte_session_signing_secret_here

# Out-of-Band Delivery Providers (Optional — system runs simulated dispatch if omitted)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
# SENDGRID_API_KEY=
# SENDGRID_FROM_EMAIL=

# External AI Services (Optional — deterministic heuristic analysis active by default)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
