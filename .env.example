# RealityVault AI + DocSenseAI Environment Configuration
# NEVER COMMIT SECRETS OR REAL PASSWORDS TO GIT

# Application URLs
APP_URL=http://localhost:3000
API_URL=http://localhost:3000/api
NODE_ENV=development

# Database (PostgreSQL + Prisma)
# Replace with your PostgreSQL connection string:
# Format: postgresql://<user>:<password>@<host>:<port>/<database>?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/realityvault?schema=public

# Encryption Master Secret (Used as derivation base for AES-256-GCM vault storage)
# Must be at least 32 characters in production. Never commit production keys!
VAULT_MASTER_KEY=realityvault_hackathon_master_key_secure_derivation_32b_min

# Session Secret for authentication tokens & cookie signing
SESSION_SECRET=realityvault_session_secret_min_32_bytes_hackathon_demo

# Optional External AI Services (Fallback deterministic parsers active if omitted)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
