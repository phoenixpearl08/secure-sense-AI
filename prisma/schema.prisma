// RealityVault AI + DocSenseAI Database Schema
// Provider: PostgreSQL via Prisma ORM

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  ORG_ADMIN
  SECURITY_ADMIN
  USER
}

enum SecurityLevel {
  STANDARD
  CONFIDENTIAL
  HIGH_SECURITY
  CRITICAL
  CUSTOM_AI
}

enum VaultItemStatus {
  ACTIVE
  CONSUMED
  EXPIRED
  REVOKED
  DESTROYED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AccessStatus {
  GRANTED
  DENIED
  CHALLENGED
  CONSUMED
}

// ==========================================
// 1. IDENTITY & ACCESS MANAGEMENT
// ==========================================

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]
}

model User {
  id             String         @id @default(uuid())
  email          String         @unique
  name           String
  passwordHash   String
  role           UserRole       @default(USER)
  organizationId String?
  organization   Organization?  @relation(fields: [organizationId], references: [id])
  devices        Device[]
  vaultItems     VaultItem[]    @relation("UserVaultItems")
  documents      Document[]     @relation("UserDocuments")
  meetings       Meeting[]      @relation("UserMeetings")
  auditLogs      AuditLog[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model Device {
  id             String          @id @default(uuid())
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId       String          @unique // Hardware/browser cryptographic fingerprint
  deviceName     String
  deviceType     String          // Desktop, Mobile, Browser
  trusted        Boolean         @default(true)
  lastSeen       DateTime        @default(now())
  createdAt      DateTime        @default(now())
  accessAttempts AccessAttempt[]
}

// ==========================================
// 2. REALITYVAULT CORE & CRYPTOGRAPHY METADATA
// ==========================================

model VaultItem {
  id              String          @id @default(uuid())
  accessId        String          @unique // Cryptographically secure non-enumerable token (UUID / base64url)
  title           String
  recipientEmail  String?
  creatorId       String
  creator         User            @relation("UserVaultItems", fields: [creatorId], references: [id], onDelete: Cascade)
  
  // Encrypted Payload (AES-256-GCM)
  ciphertext      String          // Base64 encrypted secret content
  iv              String          // Base64 12-byte initialization vector (unique per encryption)
  authTag         String          // Base64 16-byte GCM authentication tag
  algorithm       String          @default("AES-256-GCM")

  // Policy & Lifecycle
  securityLevel   SecurityLevel   @default(CONFIDENTIAL)
  status          VaultItemStatus @default(ACTIVE)
  maxViews        Int             @default(1)
  currentViews    Int             @default(0)
  expiresAt       DateTime?
  consumedAt      DateTime?
  revokedAt       DateTime?
  destroyedAt     DateTime?

  // Associated Policy Definition
  policyId        String?         @unique
  policy          SecurityPolicy? @relation(fields: [policyId], references: [id])

  // Related Document (for Combined Mode)
  documentId      String?
  document        Document?       @relation(fields: [documentId], references: [id])

  accessAttempts  AccessAttempt[]
  securityEvents  SecurityEvent[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model SecurityPolicy {
  id                   String      @id @default(uuid())
  vaultItemId          String?     @unique
  vaultItem            VaultItem?
  promptText           String?     // Original human natural-language instruction
  securityLevel        SecurityLevel @default(HIGH_SECURITY)
  otpRequired          Boolean     @default(false)
  otpCode              String?     // Salted/hashed OTP if active
  deviceRequired       Boolean     @default(false)
  registeredDeviceOnly Boolean     @default(false)
  senderApproval       Boolean     @default(false)
  riskDetection        Boolean     @default(true)
  maxViews             Int         @default(1)
  expiresInHours       Int         @default(24)
  rawPolicyJson        String?     // Stored normalized JSON
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  accessRules          AccessRule[]
}

model AccessRule {
  id         String         @id @default(uuid())
  policyId   String
  policy     SecurityPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  ruleType   String         // TIME_WINDOW, RECIPIENT_MATCH, DEVICE_FINGERPRINT, MAX_ATTEMPTS
  condition  String         // JSON serialized rule condition
  createdAt  DateTime       @default(now())
}

// ==========================================
// 3. VERIFICATION, THREAT & AUDIT
// ==========================================

model AccessAttempt {
  id           String       @id @default(uuid())
  vaultItemId  String
  vaultItem    VaultItem    @relation(fields: [vaultItemId], references: [id], onDelete: Cascade)
  deviceId     String?
  device       Device?      @relation(fields: [deviceId], references: [id])
  ipAddress    String?
  userAgent    String?
  status       AccessStatus
  reason       String?
  riskLevel    RiskLevel    @default(LOW)
  attemptedAt  DateTime     @default(now())
}

model SecurityEvent {
  id           String       @id @default(uuid())
  vaultItemId  String?
  vaultItem    VaultItem?   @relation(fields: [vaultItemId], references: [id], onDelete: SetNull)
  eventType    String       // FAILED_OTP, MULTIPLE_ATTEMPTS, RATE_LIMITED, CONSUMED_SUCCESS
  riskLevel    RiskLevel
  details      String       // Non-sensitive diagnostic message
  resolved     Boolean      @default(false)
  createdAt    DateTime     @default(now())
}

model AuditLog {
  id         String    @id @default(uuid())
  userId     String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String    // ITEM_CREATED, ITEM_DECRYPTED, ITEM_REVOKED, POLICY_GENERATED, DOCUMENT_ANALYZED
  entityType String    // VaultItem, Document, Policy, Auth
  entityId   String?
  ipAddress  String?
  metadata   String?   // JSON structured non-sensitive metadata (latencies, counts, status)
  timestamp  DateTime  @default(now())
}

// ==========================================
// 4. DOCSENSEAI DOCUMENT INTELLIGENCE
// ==========================================

model Document {
  id            String            @id @default(uuid())
  title         String
  fileName      String
  fileSize      Int
  mimeType      String
  extractedText String?           // Full extracted text
  pageCount     Int               @default(1)
  userId        String
  user          User              @relation("UserDocuments", fields: [userId], references: [id], onDelete: Cascade)
  chunks        DocumentChunk[]
  insights      DocumentInsight[]
  vaultItems    VaultItem[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
}

model DocumentChunk {
  id         String   @id @default(uuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  chunkIndex Int
  pageNumber Int      @default(1)
  content    String
  createdAt  DateTime @default(now())
}

model DocumentInsight {
  id          String   @id @default(uuid())
  documentId  String
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  category    String   // SUMMARY, DEADLINE, OBLIGATION, FINANCIAL, ENTITY, ANOMALY, RISK
  title       String
  description String
  pageNumber  Int?
  sectionRef  String?
  confidence  Float    @default(1.0)
  createdAt   DateTime @default(now())
}

// ==========================================
// 5. SECURE MEETINGS ARCHITECTURE
// ==========================================

model Meeting {
  id           String               @id @default(uuid())
  title        String
  scheduledFor DateTime
  hostId       String
  host         User                 @relation("UserMeetings", fields: [hostId], references: [id], onDelete: Cascade)
  securityLock Boolean              @default(true)
  status       String               @default("SCHEDULED") // SCHEDULED, ACTIVE, CONCLUDED
  participants MeetingParticipant[]
  policies     MeetingPolicy[]
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
}

model MeetingParticipant {
  id         String   @id @default(uuid())
  meetingId  String
  meeting    Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  email      String
  name       String
  role       String   @default("ATTENDEE")
  verified   Boolean  @default(false)
  joinedAt   DateTime?
}

model MeetingPolicy {
  id             String   @id @default(uuid())
  meetingId      String
  meeting        Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  enforceDevice  Boolean  @default(true)
  enforceOtp     Boolean  @default(true)
  allowRecording Boolean  @default(false)
  createdAt      DateTime @default(now())
}
